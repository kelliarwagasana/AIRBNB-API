// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  HOST
  GUEST
}

enum ListingType {
  APARTMENT
  HOUSE
  VILLA
  CABIN
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

enum ListingStatus {
  PENDING_APPROVAL
  PUBLISHED
  REJECTED
}

enum NotificationType {
  BOOKING_CREATED
  BOOKING_CONFIRMED
  BOOKING_DECLINED
  BOOKING_CANCELLED
  REVIEW_RECEIVED
  LISTING_APPROVED
  LISTING_REJECTED
  LISTING_CREATED
}

model User {
  id             String      @id @default(uuid())
  name           String
  email          String   @unique
  username       String   @unique
  phone          String
  role           Role     @default(GUEST)
  avatar         String?
  avatarPublicId String?
  isActive       Boolean  @default(true)
  bio            String?
  createdAt      DateTime @default(now())
  password       String
  updatedAt      DateTime @updatedAt
  resetToken     String?
  resetTokenExpiry DateTime?
  @@index([name])
  @@index([role])

  listings       Listing[]
  bookings       Booking[]
  reviews        Review[]
  savedListings  SavedListing[]
  notifications  Notification[]
}

model Listing {
  id             String          @id @default(uuid())
  title          String
  description    String
  location       String
  pricePerNight  Float
  guests         Int
  type           ListingType
  amenities      String[]
  rating         Float?
  status         ListingStatus @default(PUBLISHED)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  url            String?
  publicId       String?


  @@index([hostId])
  @@index([location])
  @@index([type])
  @@index([pricePerNight])
  @@index([status])

  hostId String
  host   User @relation(fields: [hostId], references: [id], onDelete: Cascade)

  bookings Booking[]
  photos   ListingPhoto[]
  reviews  Review[]
  savedBy  SavedListing[]
}

model SavedListing {
  userId    String
  listingId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@id([userId, listingId])
  @@index([userId])
}

model Booking {
  id         String            @id @default(uuid())
  checkIn    DateTime
  checkOut   DateTime
  guests     Int            @default(1)
  totalPrice Float
  status     BookingStatus  @default(PENDING)
  createdAt  DateTime      @default(now())

  @@index([guestId])
  @@index([listingId])
  @@index([status])

  guestId String
  guest   User @relation(fields: [guestId], references: [id])

  listingId String
  listing   Listing @relation(fields: [listingId], references: [id])
}

model ListingPhoto {
  id        Int     @id @default(autoincrement())
  url       String
  publicId  String?
  listingId String
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
}

model Review {
  id         Int      @id @default(autoincrement())
  rating     Int
  comment    String?
  createdAt  DateTime @default(now())

  reviewerId String
  reviewer   User     @relation(fields: [reviewerId], references: [id], onDelete: Cascade)

  @@index([reviewerId])
  @@index([listingId])

  listingId  String
  listing    Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  body      String
  read      Boolean          @default(false)
  metadata  Json?
  createdAt DateTime         @default(now())

  @@index([userId, read])
  @@index([userId, createdAt])
}

